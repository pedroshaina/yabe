    "/v1/transactions/{txid}": {
      "get": {
        "summary": "Transaction detail with prevouts and spending inputs",
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "in": "path",
            "name": "txid",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "txid": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "description": "Lowercase hex, display byte order"
                    },
                    "wtxid": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "description": "Lowercase hex, display byte order"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "locktime": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "size": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "vsize": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "isCoinbase": {
                      "type": "boolean"
                    },
                    "fee": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "Amount in satoshis"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "feeRate": {
                      "description": "sat/vB, 2 decimals",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "totalIn": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "Amount in satoshis"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "totalOut": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Amount in satoshis"
                    },
                    "confirmations": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "block": {
                      "type": "object",
                      "properties": {
                        "height": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "hash": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$",
                          "description": "Lowercase hex, display byte order"
                        },
                        "time": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": [
                        "height",
                        "hash",
                        "time"
                      ],
                      "additionalProperties": false
                    },
                    "inputs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "vin": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "coinbase": {
                            "type": "boolean"
                          },
                          "prevout": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "txid": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{64}$",
                                    "description": "Lowercase hex, display byte order"
                                  },
                                  "vout": {
                                    "type": "integer",
                                    "minimum": -9007199254740991,
                                    "maximum": 9007199254740991
                                  },
                                  "value": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991,
                                    "description": "Amount in satoshis"
                                  },
                                  "address": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "scriptType": {
                                    "type": "string",
                                    "enum": [
                                      "nonstandard",
                                      "pubkey",
                                      "pubkeyhash",
                                      "scripthash",
                                      "multisig",
                                      "nulldata",
                                      "anchor",
                                      "witness_v0_keyhash",
                                      "witness_v0_scripthash",
                                      "witness_v1_taproot",
                                      "witness_unknown"
                                    ]
                                  }
                                },
                                "required": [
                                  "txid",
                                  "vout",
                                  "value",
                                  "address",
                                  "scriptType"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "scriptSig": {
                            "type": "object",
                            "properties": {
                              "hex": {
                                "type": "string"
                              },
                              "asm": {
                                "description": "Null for coinbase data or undecodable scripts",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "hex",
                              "asm"
                            ],
                            "additionalProperties": false
