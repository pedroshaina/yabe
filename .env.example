# Postgres superuser (used only by the postgres image itself)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yabe

# Application roles, created by packages/db/initdb/01-roles.sh on first start.
# These passwords are embedded in connection URLs, so keep them URL-safe
# (letters, digits, "-" and "_"; no / + @ : # % ?), e.g. generate one with `openssl rand -hex 32`.
# Changing these later has no effect on an existing volume; recreate it with
# `docker compose down -v` (this deletes all indexed data).
YABE_INDEXER_PASSWORD=change-me-too
YABE_API_PASSWORD=change-me-three

# Bitcoin Core RPC. Generate all three lines with: pnpm --filter @yabe/indexer rpcauth
# (the example below is the hash of "change-me-four"). Keep the single quotes.
BITCOIN_RPC_AUTH='yabe:00112233445566778899aabbccddeeff$7296e5f7bd051c26f7d199b3df065136217ef14d4e78f27cd0f4b860f18b81b8'
INDEXER_BITCOIN_RPC_USER=yabe
INDEXER_BITCOIN_RPC_PASSWORD=change-me-four

# The INDEXER_* and API_* URLs below are for running the apps on the host (`pnpm dev`),
# reaching Compose's services on 127.0.0.1. The yabe-indexer and yabe-api containers
# ignore them: compose.yaml builds their URLs from the passwords above.
# The password must match YABE_INDEXER_PASSWORD above.
INDEXER_DATABASE_URL=postgresql://yabe_indexer:change-me-too@127.0.0.1:5432/yabe
INDEXER_BITCOIN_NETWORK=signet
INDEXER_BITCOIN_RPC_URL=http://127.0.0.1:38332
# Optional (defaults shown). A reorg deeper than INDEXER_MAX_REORG_DEPTH stops the indexer instead of rolling back.
# In Compose, yabe-indexer then restarts up to 5 times (counted since Compose last started it)
# and stays stopped; see `docker compose logs yabe-indexer`. Node or database outages never stop it.
# INDEXER_MAX_REORG_DEPTH=100
# INDEXER_POLL_INTERVAL_MS=5000
# INDEXER_BITCOIN_RPC_TIMEOUT_MS=30000
# LOG_LEVEL=info

# API running on the host (`pnpm dev:api`); read-only role.
# The password must match YABE_API_PASSWORD above.
API_DATABASE_URL=postgresql://yabe_api:change-me-three@127.0.0.1:5432/yabe
# Optional (defaults shown):
# API_HOST=0.0.0.0
# API_PORT=8080
# API_CORS_ORIGINS=          # comma-separated, e.g. http://localhost:5173
# API_QUERY_TIMEOUT_MS=10000
