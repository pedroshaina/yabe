{
  "name": "yabe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @yabe/db generate",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:indexer": "pnpm --filter @yabe/indexer dev",
    "dev:api": "pnpm --filter @yabe/api dev",
    "openapi": "pnpm --filter @yabe/api openapi",
    "dev:web": "pnpm --filter @yabe/web dev",
    "web:types": "pnpm --filter @yabe/web types"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "24.19.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
